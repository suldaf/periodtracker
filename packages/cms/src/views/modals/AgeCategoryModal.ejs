<!-- Modal -->
<div
  class="modal fade"
  id="ageCategoryModal"
  tabindex="-1"
  role="dialog"
  aria-labelledby="dynamicModalLabel"
  aria-hidden="true"
>
  <div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="dynamicModalLabel"><%= __('Age Category')%></h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <table class="table table-borderless modal-table">
          <thead>
            <tr>
              <th style="width: 60%"><%= __('Name')%></th>
              <th style="width: 20%"><%= __('Min Age')%></th>
              <th style="width: 20%"><%= __('Max Age')%></th>
            </tr>
          </thead>
          <tbody style="overflow-y: scroll; align-items: center;">
            <td style="width: 60%">
              <input type="text" class="form-control" id="colAgeCategory0TableModal" />
              <p id="errorAgeCategory1" style="display: none;">required field</p>
            </td>
            <td style="width: 20%">
              <input type="number" class="form-control" id="colAgeCategory1TableModal" placeholder="Optional" min="0" />
            </td>
            <td style="width: 20%">
              <input type="number" class="form-control" id="colAgeCategory2TableModal" placeholder="Optional" min="0" />
            </td>
          </tbody>
        </table>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal"><%= __('Close')%></button>
        <button type="submit" class="btn btn-primary" id="btnAgeCategoryConfirm"><%= __('Confirm')%></button>
      </div>
    </div>
  </div>
  <span id="itemID" hidden></span>
</div>
