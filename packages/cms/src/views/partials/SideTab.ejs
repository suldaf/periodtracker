<!-- Category Management with submenu -->
<div class="menu-section">
  <div class="menu-title" onclick="toggleSubmenu(this)">
    <h6><%= __('Category Management')%></h6>
    <i class="fas fa-chevron-down submenu-icon"></i>
  </div>
  <div class="submenu">
    <a href="/categories-management"><h6 class="submenu-item"><%= __('Categories')%></h6></a>
