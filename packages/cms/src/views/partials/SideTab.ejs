<a href="/help-center-management"><h6><%= __('Help centers')%></h6></a>

<script>
function toggleSubmenu(element) {
  const menuSection = element.parentElement;
  const submenu = menuSection.querySelector('.submenu');
  const icon = element.querySelector('.submenu-icon');
  
  if (submenu.style.maxHeight && submenu.style.maxHeight !== '0px') {
    submenu.style.maxHeight = '0px';
    icon.style.transform = 'rotate(0deg)';
  } else {
    submenu.style.maxHeight = submenu.scrollHeight + 'px';
    icon.style.transform = 'rotate(180deg)';
  }
}

// Auto-expand active menu
document.addEventListener('DOMContentLoaded', function() {
  const currentPath = window.location.pathname;
  const menuSections = document.querySelectorAll('.menu-section');
  
  menuSections.forEach(section => {
    const links = section.querySelectorAll('.submenu a');
    links.forEach(link => {
      if (link.getAttribute('href') === currentPath) {
        const submenu = section.querySelector('.submenu');
        const menuTitle = section.querySelector('.menu-title');
        const icon = menuTitle.querySelector('.submenu-icon');
        submenu.style.maxHeight = submenu.scrollHeight + 'px';
        icon.style.transform = 'rotate(180deg)';
      }
    });
  });
});
</script>
